# Any PostgreSQL connection string. A Neon URL uses Neon's HTTP driver; every
# other host uses the standard Postgres wire protocol, so Netlify Database,
# Supabase, Railway and local Postgres all work.
# Leave empty when Netlify Database is connected: the platform injects
# NETLIFY_DB_URL automatically and the app prefers it.
DATABASE_URL=

# The administrator uses the same /login page as every other account.
# BOTH values are required — with either one missing, no administrator account
# is created and /admin becomes unreachable. Check /api/health to confirm:
# it reports "admin":"configured" only when both are set correctly.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Valtra Assets Admin

# Session cookies last 7 days, or 30 days when "Keep me signed in" is enabled.
# Login throttling is shared across instances and stored as hashed keys in PostgreSQL:
# 12 attempts per identifier and 60 per IP per 10-minute window.

# Optional public settlement-wallet overrides. Leave blank to use src/config/site.ts.
NEXT_PUBLIC_WALLET_USDT_BEP20=
NEXT_PUBLIC_WALLET_USDT_TRC20=
NEXT_PUBLIC_WALLET_BTC=
NEXT_PUBLIC_WALLET_BNB=
NEXT_PUBLIC_WALLET_USDC_BEP20=
NEXT_PUBLIC_WALLET_SOL=
NEXT_PUBLIC_WALLET_USDC_SUI=
